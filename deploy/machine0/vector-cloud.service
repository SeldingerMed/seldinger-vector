[Unit]
Description=Vector Cloud control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/vector
EnvironmentFile=/home/ubuntu/vector/.env.production
ExecStart=/home/ubuntu/vector/.venv/bin/uvicorn or_audit.cloud.api:app_from_env --factory --host 127.0.0.1 --port 8080
Restart=always
Environment=PATH=/home/ubuntu/.nvm/versions/node/v26.7.0/bin:/home/ubuntu/vector/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/vector-data /home/ubuntu/.machine0 /home/ubuntu/.ssh

[Install]
WantedBy=multi-user.target
